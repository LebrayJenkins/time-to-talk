<!doctype html>
<html lang="sv">

<%- include("partials/head", {
    title: "Välj datum och tid",
    pageStylesheets: [
        "/stylesheets/student-available-times.css",
        "/stylesheets/logo.css"
    ]
}) %>

<body class="student-available-times">

    <a class="skip-link" href="#main-content">
        Hoppa till huvudinnehållet
    </a>

    <!-- Mobilheader med menyknapp -->
    <header class="mobile-header">
        <button
            type="button"
            class="btn btn-outline-dark mobile-menu-button d-md-none"
            data-bs-toggle="offcanvas"
            data-bs-target="#student-mobile-menu"
            aria-controls="student-mobile-menu"
            aria-label="Öppna meny">
            <span aria-hidden="true">☰</span>
        </button>
    </header>

    <!-- Logotyp som hero på mobil -->
    <div class="mobile-logo-hero">
        <%- include("partials/logo") %>
    </div>

    <div class="dashboard-layout">

        <!-- Elevmeny -->
        <%- include("partials/student-sidebar") %>

        <!-- Huvudinnehåll -->
        <main id="main-content" class="dashboard-main" tabindex="-1">

            <section aria-labelledby="available-times-heading">

                <h1 id="available-times-heading" class="h4 mb-4">
                    Välj datum och tid
                </h1>

                <!-- Välj aktivitet -->
                <div class="mb-4">

                    <label for="activity-filter" class="form-label">
                        Välj aktivitet
                    </label>

                    <select
                        id="activity-filter"
                        name="activity"
                        class="form-select">

                        <option value="">
                            Alla aktiviteter
                        </option>

                        <option value="Handledning">
                            Handledning
                        </option>

                        <option value="Redovisning">
                            Redovisning
                        </option>

                        <option value="Muntligt förhör">
                            Muntligt förhör
                        </option>

                    </select>

                </div>

                <!-- Lediga tider -->
                <section aria-labelledby="times-heading">

                    <h2 id="times-heading" class="h5 mb-3">
                        Välj datum och tid
                    </h2>

                    <% if (availableTimes && availableTimes.length > 0) { %>

                        <div class="available-times-list">

                            <% availableTimes.forEach(function(time) { %>

                                <article
                                        class="available-time-card"
                                        data-activity="<%= time.activity %>">

                                    <div class="available-time-information">

                                        <p class="available-time-date">
                                            <strong>
                                                <%= time.date %>
                                            </strong>
                                        </p>

                                        <p class="available-time-clock">
                                            <time datetime="<%= time.date %>T<%= time.start_time %>">
                                                <%= time.start_time %>
                                            </time>
                                            –
                                            <time datetime="<%= time.date %>T<%= time.end_time %>">
                                                <%= time.end_time %>
                                            </time>
                                        </p>

                                        <p class="available-time-activity">
                                            <%= time.activity %>
                                        </p>

                                        <p class="available-time-teacher">
                                            Lärare: <%= time.teacher_name %>
                                        </p>

                                    </div>

                                    <!-- Själva bokningen kopplas i nästa PBI -->
                                    <button
                                        type="button"
                                        class="btn btn-outline-dark select-time-button"
                                        data-time-id="<%= time.id %>">
                                        Välj tid
                                    </button>

                                </article>

                            <% }); %>

                        </div>

                    <% } else { %>

                        <p>
                            Det finns inga lediga tider just nu.
                        </p>

                    <% } %>

                </section>

                <!-- Fortsätt kopplas till bokningsbekräftelsen i nästa PBI -->
                <div class="available-times-actions">

                    <button
                        type="button"
                        class="btn btn-dark"
                        disabled>
                        Fortsätt
                    </button>

                </div>

            </section>

        </main>

    </div>
    <%- include("partials/scripts") %>
    <script src="/javascripts/student-available-times.js"></script>


</body>

</html>