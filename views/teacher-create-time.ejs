<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skapa ny tid - Time To Talk</title>
</head>

<body>

    <main>
        <h1>Skapa ny tid</h1>

        <form action="/teacher/tider/skapa" method="POST">

            <div>
                <label for="activity">Välj aktivitet</label>

                <select id="activity" name="activity" required>
                    <option value="">Välj aktivitet</option>
                    <option value="Handledning">Handledning</option>
                    <option value="Presentation">Presentation</option>
                    <option value="Muntligt förhör">Muntligt förhör</option>
                </select>
            </div>

            <div>
                <label for="date">Datum</label>
                <input
                    type="date"
                    id="date"
                    name="date"
                    min="<%= new Date().toISOString().split('T')[0] %>"
                    required
                >
            </div>

            <div>
                <label for="start_time">Starttid</label>
                <input
                    type="time"
                    id="start_time"
                    name="start_time"
                    required
                >
            </div>

            <div>
                <label for="end_time">Sluttid</label>
                <input
                    type="time"
                    id="end_time"
                    name="end_time"
                    required
                >
            </div>


            <button type="submit">Publicera tid</button>

        </form>
    </main>

</body>
</html>