<!DOCTYPE html>
<html lang="sv">

<%- include("partials/head", {
        title: "Skapa ny tid",
        pageStylesheet: "/stylesheets/teacher-create-time.css"
}) %>


<body>

    <div class="page">

        <!-- Vänstersidomeny -->
        <%- include("partials/teacher-sidebar") %>

        <!-- Huvudinnehåll -->
        <main class="main-content">

            <div class="content-wrapper">

                <h1>Skapa ny tid</h1>

                <form action="/teacher/tider/skapa" method="POST">

                    <!-- Aktivitet -->
                    <div class="mb-4">
                        <label for="activity" class="form-label">
                            Välj aktivitet
                        </label>

                        <select
                            id="activity"
                            name="activity"
                            class="form-select"
                            required
                        >
                            <option value="">Välj aktivitet</option>
                            <option value="Handledning">Handledning</option>
                            <option value="Redovisning">Redovisning</option>
                            <option value="Muntligt förhör">Muntligt förhör</option>
                        </select>
                    </div>

                    <!-- Datum -->
                    <div class="mb-4">
                        <label for="date" class="form-label">
                            Datum
                        </label>

                        <input
                            type="date"
                            id="date"
                            name="date"
                            class="form-control"
                            min="<%= new Date().toISOString().split('T')[0] %>"
                            required
                        >
                    </div>

                    <!-- Tid -->
                    <div class="mb-4">
                        <label class="form-label">
                            Tid
                        </label>

                        <div class="row g-3">

                            <div class="col-12 col-sm-6">
                                <label for="start_time" class="form-label">
                                    Starttid
                                </label>

                                <input
                                    type="time"
                                    id="start_time"
                                    name="start_time"
                                    class="form-control"
                                    required
                                >
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="end_time" class="form-label">
                                    Sluttid
                                </label>

                                <input
                                    type="time"
                                    id="end_time"
                                    name="end_time"
                                    class="form-control"
                                    required
                                >
                            </div>

                        </div>
                    </div>

                    <!-- Knappar -->
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-end mt-4">

                        <button
                            type="button"
                            class="btn button-cancel"
                            onclick="history.back()"
                        >
                            Avbryt
                        </button>

                        <button
                            type="submit"
                            class="btn button-submit"
                        >
                            Publicera tid
                        </button>

                    </div>

                </form>

            </div>

        </main>

    </div>

</body>
</html>