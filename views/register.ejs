<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skapa konto – Time To Talk</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/auth.css">
    <link rel="stylesheet" href="/stylesheets/logo.css">
</head>
<body>

    <main class="auth-container">
        
        <!-- Logotyp och Namn -->
        <%- include("partials/logo") %>

        <p class="auth-subtitle">Skapa ett konto för att använda systemet.</p>

        <!-- Tydligt Felmeddelande -->
        <% if (error) { %>
            <div class="alert-error" role="alert" id="error-message">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Registreringsformulär -->
        <form action="/register" method="POST" novalidate>

            <div class="form-field">
                <label for="name" class="field-label">Fullständigt namn</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </span>
                    <input 
                        type="text" 
                        id="name" 
                        name="name" 
                        placeholder="t.ex. Martin Lindgren eller Sara" 
                        value="<%= name || '' %>" 
                        required
                    >
                </div>
            </div>

            <div class="form-field">
                <label for="email" class="field-label">E-postadress</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </svg>
                    </span>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        placeholder="namn@skola.se" 
                        value="<%= email || '' %>" 
                        required
                    >
                </div>
            </div>

            <div class="form-field">
                <label for="password" class="field-label">Välj lösenord</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                        </svg>
                    </span>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="••••••••" 
                        required
                    >
                </div>
            </div>

            <div class="form-field">
                <label for="role" class="field-label">Roll</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                        </svg>
                    </span>
                    <select id="role" name="role" style="height: 44px; width: 100%; border: none; background: transparent; padding: 0 14px 0 42px; font-size: 14px; outline: none;">
                        <option value="teacher" <%= role === 'teacher' ? 'selected' : '' %>>Lärare</option>
                        <option value="student" <%= role === 'student' ? 'selected' : '' %>>Elev</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-login" id="register-submit">
                Skapa konto
            </button>

            <div class="auth-footer">
                <span style="font-size: 14px; color: #555;">Har du redan ett konto?</span>
                <a href="/login" class="auth-link" style="margin-left: 6px; font-weight: bold;">Logga in här</a>
            </div>
        </form>

    </main>

</body>
</html>
