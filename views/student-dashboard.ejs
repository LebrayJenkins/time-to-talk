<!doctype html>
<html lang="sv">

<%- include("partials/head", { title: "Min översikt" , pageStylesheet: "/stylesheets/student-dashboard.css" }) %>

    <body class="student-dashboard">

        <a class="skip-link" href="#main-content">
            Hoppa till huvudinnehållet
        </a>

        <div class="dashboard-layout">

            <%- include("partials/student-sidebar") %>

                <main id="main-content" class="dashboard-main" tabindex="-1">

                    <header class="dashboard-header">
                        <p class="dashboard-brand">TimeToTalk</p>

                        <button type="button" class="btn btn-outline-dark d-md-none dashboard-menu-button"
                            data-bs-toggle="offcanvas" data-bs-target="#student-mobile-menu"
                            aria-controls="student-mobile-menu" aria-label="Öppna meny">
                            <span aria-hidden="true">☰</span>
                        </button>
                    </header>

                    <h1 class="h4 mb-4">Välkommen!</h1>

                    <section class="dashboard-bookings mb-4" aria-labelledby="bookings-heading">
                        <h2 id="bookings-heading" class="h5 mb-4">
                            Mina kommande bokningar
                        </h2>

                        <!-- Exempeldata tills databasen kopplas in -->
                        <article class="booking-card d-flex flex-wrap align-items-center gap-3">
                            <div class="booking-date">
                                <span>Tis</span>
                                <strong>22</strong>
                                <span>Sep</span>
                            </div>

                            <div class="booking-information">
                                <h3 class="h6">Handledning</h3>
                                <p>Lärare: Sara</p>
                                <p>
                                    <time datetime="2026-09-22T13:00">13:00</time>
                                    –
                                    <time datetime="2026-09-22T13:30">13:30</time>
                                </p>
                            </div>

                            <!-- Funktionen kopplas in senare -->
                            <button type="button" class="btn btn-outline-dark ms-auto">
                                Visa detaljer
                            </button>
                        </article>
                    </section>

                    <section class="dashboard-actions" aria-labelledby="actions-heading">
                        <h2 id="actions-heading" class="h5 mb-3">
                            Vad vill du göra?
                        </h2>

                        <div class="row g-3">

                            <div class="col-6">
                                <div class="dashboard-action d-flex flex-column
                     align-items-center justify-content-between
                     gap-4 h-100 text-center">
                                    <div class="action-symbol rounded-circle d-flex
                       align-items-center justify-content-center" aria-hidden="true">
                                        ▦
                                    </div>

                                    <!-- Funktionen kopplas in senare -->
                                    <button type="button" class="btn btn-outline-dark w-100">
                                        Boka handledning
                                    </button>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="dashboard-action d-flex flex-column
                     align-items-center justify-content-between
                     gap-4 h-100 text-center">
                                    <div class="action-symbol rounded-circle d-flex
                       align-items-center justify-content-center" aria-hidden="true">
                                        ✓
                                    </div>

                                    <!-- Funktionen kopplas in senare -->
                                    <button type="button" class="btn btn-outline-dark w-100">
                                        Boka redovisning
                                    </button>
                                </div>
                            </div>

                        </div>
                    </section>

                </main>
        </div>

        <%- include("partials/scripts") %>

    </body>

</html>