<!doctype html>
<html lang="sv">

<%- include("partials/head", {
    title: "Min översikt",
    pageStylesheets: [
        "/stylesheets/teacher-dashboard.css",
        "/stylesheets/teacher-sidebar.css",
        "/stylesheets/logo.css"
    ]
}) %>

<body class="teacher-dashboard">

    <a class="skip-link" href="#main-content">
        Hoppa till huvudinnehållet
    </a>

    <div class="dashboard-layout">

        <!-- Lärarmeny -->
        <%- include("partials/teacher-sidebar") %>

        <main id="main-content" class="dashboard-main" tabindex="-1">

            <!-- Mobilheader med menyknapp och logotyp -->
            <header class="dashboard-header d-md-none">
                <button
                    type="button"
                    class="btn btn-outline-dark dashboard-menu-button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#teacher-mobile-menu"
                    aria-controls="teacher-mobile-menu"
                    aria-label="Öppna meny">
                    <span aria-hidden="true">☰</span>
                </button>

                <div class="mobile-logo-hero">
                    <%- include("partials/logo") %>
                </div>
            </header>

            <!-- Välkomsthälsning -->
            <h1 class="h4 mb-4">
                Hej <%= (typeof teacher !== "undefined" && teacher && teacher.name) ? teacher.name.split(' ')[0] : "Sara" %>! 👋
            </h1>

            <!-- Dagens bokningar -->
            <section class="dashboard-bookings mb-4" aria-labelledby="bookings-heading">
                
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 booking-header">
                    <h2 id="bookings-heading" class="h6 fw-bold mb-0">
                        Dagens bokningar - <%= typeof todayFormatted !== "undefined" ? todayFormatted : "17 sep" %>
                    </h2>
                    <button type="button" class="btn btn-calendar" onclick="alert('Kalender öppnas');">
                        visa kalender
                    </button>
                </div>

                <div class="booking-list">
                    <% if (typeof bookings !== "undefined" && bookings && bookings.length > 0) { %>
                        <% bookings.forEach(function(booking, index) { %>
                            <div class="row align-items-center booking-row <%= index < bookings.length - 1 ? 'border-bottom' : '' %>">
                                <div class="col-4 fw-bold">
                                    <%= booking.start_time %>-<%= booking.end_time %>
                                </div>
                                <div class="col-4 fw-bold text-center">
                                    <%= booking.student_name ? booking.student_name : '-' %>
                                </div>
                                <div class="col-4 fw-bold text-end">
                                    <%= booking.activity || '' %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="py-3 text-center text-muted fw-semibold">
                            Inga bokade tider idag
                        </div>
                    <% } %>
                </div>

            </section>

            <!-- Snabbåtgärder -->
            <section class="dashboard-actions" aria-labelledby="actions-heading">
                <h2 id="actions-heading" class="h5 mb-3">
                    Snabbåtgärder
                </h2>

                <div class="row g-3">
                    <!-- Skapa ny tid -->
                    <div class="col-6">
                        <div class="dashboard-action d-flex flex-column align-items-center justify-content-between gap-4 h-100 text-center">
                            <div class="action-symbol rounded-circle d-flex align-items-center justify-content-center" aria-hidden="true">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                    <line x1="12" y1="14" x2="12" y2="18"></line>
                                    <line x1="10" y1="16" x2="14" y2="16"></line>
                                </svg>
                            </div>
                            <a href="/teacher/tider/skapa" class="btn btn-outline-dark w-100">
                                Skapa ny tid
                            </a>
                        </div>
                    </div>

                    <!-- Visa Kalender -->
                    <div class="col-6">
                        <div class="dashboard-action d-flex flex-column align-items-center justify-content-between gap-4 h-100 text-center">
                            <div class="action-symbol rounded-circle d-flex align-items-center justify-content-center" aria-hidden="true">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                    <circle cx="8" cy="14" r="1" fill="#111111"></circle>
                                    <circle cx="12" cy="14" r="1" fill="#111111"></circle>
                                    <circle cx="16" cy="14" r="1" fill="#111111"></circle>
                                    <circle cx="8" cy="17" r="1" fill="#111111"></circle>
                                    <circle cx="12" cy="17" r="1" fill="#111111"></circle>
                                    <circle cx="16" cy="17" r="1" fill="#111111"></circle>
                                </svg>
                            </div>
                            <button type="button" class="btn btn-outline-dark w-100" onclick="alert('Kalenderfunktionen är under utveckling');">
                                Visa Kalender
                            </button>
                        </div>
                    </div>
                </div>
            </section>

        </main>

    </div>

    <%- include("partials/scripts") %>
</body>
</html>
