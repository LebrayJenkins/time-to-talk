<!doctype html>
<html lang="sv">

<%- include("partials/head", { title: "Min översikt" , pageStylesheets: [ "/stylesheets/teacher-dashboard.css"
    , "/stylesheets/teacher-sidebar.css" , "/stylesheets/logo.css" ] }) %>

    <body class="teacher-dashboard">

        <a class="skip-link" href="#main-content">
            Hoppa till huvudinnehållet
        </a>

        <!-- Menyknapp för mobil -->
        <div class="dashboard-header d-md-none">
            <button type="button" class="btn btn-outline-dark dashboard-menu-button" data-bs-toggle="offcanvas"
                data-bs-target="#teacher-mobile-menu" aria-controls="teacher-mobile-menu" aria-label="Öppna meny">
                <span aria-hidden="true">☰</span>
            </button>
        </div>

        <!-- Logotyp för mobil -->
        <div class="mobile-logo-hero">
            <%- include("partials/logo") %>
        </div>

        <div class="dashboard-layout">

            <%- include("partials/teacher-sidebar") %>

                <main id="main-content" class="dashboard-main" tabindex="-1">

                    <!-- Välkomsthälsning -->
                    <h1 class="h4 mb-4">
                        Välkommen, <%= teacher.name %>!
                    </h1>

                    <!-- Dagens bokningar -->
                    <section id="bokningar" class="dashboard-bookings mb-4" aria-labelledby="bookings-heading">

                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 booking-header">

                            <h2 id="bookings-heading" class="h6 fw-bold mb-0">
                                Dagens bokningar –
                                <%= typeof todayFormatted !=="undefined" ? todayFormatted : "" %>
                            </h2>

                        </div>

                        <div class="booking-list">

                            <% if (typeof bookings !=="undefined" && bookings && bookings.length> 0) { %>

                                <% bookings.forEach(function(booking) { %>

                                    <div class="row align-items-center booking-row gy-2">

                                        <div class="col-12 col-md-3 fw-bold">
                                            <span>
                                                <%= booking.start_time %>–<%= booking.end_time %>
                                            </span>
                                        </div>

                                        <div class="col-6 col-md-3 fw-bold text-md-center">
                                            <%= booking.student_name || "-" %>
                                        </div>

                                        <div class="col-6 col-md-3 fw-bold text-md-center">
                                            <%= booking.activity || "" %>
                                        </div>

                                        <div class="col-12 col-md-3 text-md-end">
                                            <a href="/teacher/bokningar/<%= booking.booking_id || booking.id %>"
                                                class="btn btn-outline-dark d-inline-flex align-items-center justify-content-center">
                                                Visa detaljer
                                            </a>
                                        </div>

                                    </div>

                                    <% }); %>

                                        <% } else { %>

                                            <p class="py-3 text-center text-muted fw-semibold mb-0">
                                                Inga bokningar idag
                                            </p>

                                            <% } %>

                        </div>

                    </section>

                    <!-- Snabbåtgärder -->
                    <section class="dashboard-actions" aria-labelledby="actions-heading">

                        <h2 id="actions-heading" class="h5 mb-3">
                            Snabbåtgärder
                        </h2>

                        <div class="row g-3">

                            <div class="col-12 col-sm-6">

                                <div
                                    class="dashboard-action d-flex flex-column align-items-center justify-content-between gap-4 h-100 text-center">

                                    <div class="action-symbol rounded-circle d-flex align-items-center justify-content-center"
                                        aria-hidden="true">

                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#111111"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                            focusable="false">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>

                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                            <line x1="12" y1="14" x2="12" y2="18"></line>
                                            <line x1="10" y1="16" x2="14" y2="16"></line>
                                        </svg>

                                    </div>

                                    <a href="/teacher/tider/skapa" class="btn btn-outline-dark w-100">
                                        Skapa ny tid
                                    </a>

                                </div>

                            </div>

                        </div>

                    </section>

                </main>

        </div>

        <%- include("partials/scripts") %>

    </body>

</html>