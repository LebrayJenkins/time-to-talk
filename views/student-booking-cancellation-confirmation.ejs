<!doctype html>
<html lang="sv">

<%- include("partials/head", { title: "Bekräfta avbokning" , pageStylesheets: [ "/stylesheets/student-sidebar.css"
    , "/stylesheets/student-booking-cancellation-confirmation.css" , "/stylesheets/logo.css" ] }) %>

    <body class="student-booking-cancellation-confirmation">
        <a class="skip-link" href="#main-content">
            Hoppa till huvudinnehållet
        </a>

        <div class="booking-details-layout">
            <%- include("partials/student-sidebar") %>

                <main id="main-content" class="booking-details-main" tabindex="-1">
                    <header class="booking-details-header d-md-none">
                        <button type="button" class="btn btn-outline-dark booking-details-menu"
                            data-bs-toggle="offcanvas" data-bs-target="#student-mobile-menu"
                            aria-controls="student-mobile-menu" aria-label="Öppna meny">
                            <span aria-hidden="true">☰</span>
                        </button>
                    </header>

                    <div class="mobile-logo-hero">
                        <%- include("partials/logo") %>
                    </div>

                    <div class="booking-details-content">
                        <h1 class="h4 mb-4">Avboka din tid?</h1>

                        <section class="booking-details-card" aria-labelledby="booking-heading">
                            <h2 id="booking-heading" class="h5 mb-4">
                                <%= booking.activity %>
                            </h2>

                            <dl class="booking-details-information">
                                <dt>Lärare</dt>
                                <dd>
                                    <%= booking.teacher_name %>
                                </dd>

                                <dt>Datum</dt>
                                <dd>
                                    <time datetime="<%= booking.date %>">
                                        <%= booking.date %>
                                    </time>
                                </dd>

                                <dt>Tid</dt>
                                <dd>
                                    <time datetime="<%= booking.date %>T<%= booking.start_time %>">
                                        <%= booking.start_time.slice(0, 5) %>
                                    </time>
                                    –
                                    <time datetime="<%= booking.date %>T<%= booking.end_time %>">
                                        <%= booking.end_time.slice(0, 5) %>
                                    </time>
                                </dd>
                            </dl>
                        </section>

                        <div class="booking-details-actions">
                            <a href="/student/bokningar/<%= booking.id %>" class="btn btn-outline-dark">
                                Behåll bokningen
                            </a>

                            <form action="/student/bokningar/<%= booking.id %>/avboka" method="post">
                                <button type="submit" class="btn btn-danger">
                                    Bekräfta avbokning
                                </button>
                            </form>
                        </div>
                    </div>
                </main>
        </div>

        <%- include("partials/scripts") %>
    </body>

</html>